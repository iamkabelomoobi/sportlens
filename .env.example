# Hosted data services (Supabase Postgres + Upstash Redis)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
MAIL_PROVIDER=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@sportlens.local
RESEND_API_KEY=
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sportlens
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/sportlens
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=sportlens
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
PAYLOAD_SECRET=replace-with-a-long-local-secret
CMS_PORT=3000
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PAYLOAD_SCHEMA_PUSH=true
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:3001
SPORTLENS_RATE_FREE=1000
SPORTLENS_RATE_DEVELOPER=50000
SPORTLENS_RATE_BUSINESS=500000
SPORTLENS_RATE_ENTERPRISE=5000000
