{
  "name": "@sportlens/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-env.mjs dev -p ${CMS_PORT:-3000}",
    "build": "next build",
    "start": "node scripts/with-env.mjs start -p ${CMS_PORT:-3000}",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node ../../packages/domain/node_modules/vitest/vitest.mjs run",
    "seed": "node --env-file=../../.env --import tsx/esm src/seed.ts",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.16",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "next": "^16.3.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sass": "^1.77.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
